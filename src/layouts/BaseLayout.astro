---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withoutBase } from '../utils/paths';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Limitless Church is a life-giving church helping people encounter God, love people, and find purpose.',
  noindex = false
} = Astro.props;
const pathname = Astro.url.pathname;
const enableBladePreview = withoutBase(pathname) === '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header pathname={pathname} enableBladePreview={enableBladePreview} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 999;
    background: #fff;
    color: #0f1115;
    padding: 0.6rem 0.9rem;
    border-radius: 0.35rem;
    box-shadow: 0 0 0 2px rgba(16, 18, 24, 0.35);
  }

  .skip-link:focus-visible {
    left: 0.75rem;
    top: 0.75rem;
  }
</style>

<script is:inline>
  const initOutlineParallax = () => {
    const outlines = Array.from(document.querySelectorAll('.outline-graphic')).filter(
      (element) => element instanceof HTMLElement
    );

    if (!outlines.length || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let ticking = false;

    const updateOutlines = () => {
      const viewportHeight = window.innerHeight || 1;

      outlines.forEach((outline, index) => {
        const rect = outline.getBoundingClientRect();
        const center = rect.top + rect.height / 2;
        const normalizedOffset = (center - viewportHeight / 2) / viewportHeight;
        const speed = 58 + (index % 4) * 16;
        const translateY = normalizedOffset * speed * -1;
        const translateX = normalizedOffset * (speed * 0.38) * (index % 2 === 0 ? 1 : -1);

        outline.style.setProperty('--outline-scroll-y', `${translateY.toFixed(2)}px`);
        outline.style.setProperty('--outline-scroll-x', `${translateX.toFixed(2)}px`);
      });

      ticking = false;
    };

    const requestUpdate = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(updateOutlines);
    };

    requestUpdate();
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initOutlineParallax, { once: true });
  } else {
    initOutlineParallax();
  }
</script>

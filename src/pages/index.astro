---
import BaseLayout from '../layouts/BaseLayout.astro';
import FullSpanVideoHero from '../components/FullSpanVideoHero.astro';
import OutlineGraphic from '../components/OutlineGraphic.astro';
import { churchMeta } from '../data/site';
import { media } from '../data/media';
import { withBase } from '../utils/paths';
import { events, messages, ministries, staff, values } from '../data/content';

const featuredMessage = messages.find((message) => message.featured) ?? messages[0];
const recentMessages = messages.filter((message) => message.title !== featuredMessage.title).slice(0, 2);
const featuredValues = values.slice(0, 6);
const sundayTimes = churchMeta.serviceTimes.slice(0, 4);
const firstWednesday = churchMeta.serviceTimes.find((time) => time.includes('First Wednesday')) ?? '';
const newHereParty = events.find((event) => event.title === 'New Here Party') ?? events[0];
const leadPastor = staff[0];

const ministryLinks = [
  { ...ministries[0], href: '/kids', cta: 'Explore Kids' },
  { ...ministries[1], href: '/next-steps', cta: 'Students + Families' },
  { ...ministries[2], href: '/next-steps', cta: 'Find A Group' }
];
---

<BaseLayout title="Limitless Church | Home">
  <div class="home-page">
    <section class="section home-hero-wrap">
      <FullSpanVideoHero
        contained={false}
        eyebrow="This Sunday In Nixa"
        title="Limitless Church"
        text=""
        supportEyebrow=""
        supportTitle=""
        supportMeta=""
        leftPillars={['Encounter God.', 'Love People.', 'Find Purpose.']}
        poster={media.heroes.home}
        videoAlt="Limitless Church home hero media"
        supportVisible={false}
        serviceSummary="Sundays at 8:00, 9:30, 11:00, and 12:30"
        location={churchMeta.address}
      />
    </section>

    <section class="section surface-white home-visit-band">
      <div class="container home-visit-shell" data-rail-shell>
        <div class="home-visit-head">
          <div class="stack-sm">
            <p class="home-label">New Here</p>
            <h2 class="home-display home-display-dark home-visit-title">Your first Sunday.</h2>
          </div>
          <p class="home-visit-copy">
            We want your first visit to feel simple, welcoming, and easy to navigate for you and your family.
          </p>
        </div>

        <div class="home-visit-toolbar">
          <p class="home-toolbar-note">Slide through the details.</p>
          <div class="home-rail-controls home-rail-controls-dark">
            <button type="button" class="home-rail-button home-rail-button-dark" data-rail-prev aria-label="Scroll first visit details left">←</button>
            <button type="button" class="home-rail-button home-rail-button-dark" data-rail-next aria-label="Scroll first visit details right">→</button>
          </div>
        </div>

        <div class="home-visit-rail" data-home-rail data-scroll-rail>
          <article class="home-visit-slide home-visit-slide-primary">
            <div class="home-visit-slide-copy">
              <p class="home-item-label">Sunday Service Times</p>
              <h3>Choose a time and come as you are.</h3>
              <ul class="home-time-list">
                {sundayTimes.map((time) => (
                  <li>{time.replace('Sundays at ', '')}</li>
                ))}
              </ul>
              {firstWednesday && <p class="home-visit-support">{firstWednesday}</p>}
              <a class="editorial-link editorial-link-light" href={withBase('/plan-your-visit')}>Plan Your Visit</a>
            </div>
          </article>

          <article class="home-visit-slide home-visit-slide-light">
            <div class="home-visit-slide-copy">
              <p class="home-item-label home-item-label-dark">What To Expect</p>
              <h3>Worship, practical teaching, and people ready to help.</h3>
              <ul class="home-visit-bullets">
                <li>Guest parking and a team outside to welcome you.</li>
                <li>Clear signage from the lobby to kids check-in.</li>
                <li>Biblical teaching you can apply right away.</li>
              </ul>
              <a class="editorial-link" href={withBase('/plan-your-visit')}>Get Sunday Details</a>
            </div>
          </article>

          <a href={withBase('/kids')} class="home-visit-slide home-visit-slide-image">
            <img src={ministries[0].image} alt="Limitless Kids" loading="lazy" />
            <div class="home-visit-slide-overlay"></div>
            <div class="home-visit-slide-copy">
              <p class="home-item-label">Kids + Families</p>
              <h3>{ministries[0].title}</h3>
              <p>{ministries[0].description}</p>
              <span class="editorial-link editorial-link-light">See Kids Details</span>
            </div>
          </a>

          <a href={withBase('/next-steps')} class="home-visit-slide home-visit-slide-event">
            <img src={newHereParty.image} alt={newHereParty.title} loading="lazy" />
            <div class="home-visit-slide-overlay"></div>
            <div class="home-visit-slide-copy">
              <p class="home-item-label">{newHereParty.category}</p>
              <h3>{newHereParty.title}</h3>
              <p>{newHereParty.description}</p>
              <span class="editorial-link editorial-link-light">Learn The Next Steps</span>
            </div>
          </a>
        </div>

        <div class="home-visit-footer">
          <p class="home-address">{churchMeta.address}</p>
          <div class="cluster">
            <a class="btn btn-primary" href={withBase('/plan-your-visit')}>Get Sunday Details</a>
            <a class="editorial-link" href={withBase('/kids')}>What About Kids?</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section surface-dark home-media-band">
      <div class="container home-media-shell">
        <OutlineGraphic src="/brand/mission/outline-03.png" className="home-outline home-outline-media" />

        <div class="home-media-head">
          <div class="stack-sm">
            <p class="home-label home-label-light">Messages</p>
            <h2 class="home-display home-media-title">Recent messages to watch this week.</h2>
          </div>
          <a href={withBase('/messages')} class="editorial-link">Browse All Messages</a>
        </div>

        <div class="home-media-feature">
          <div class="home-media-copy">
            <span class="home-sticker home-sticker-light">Latest At Limitless</span>
            <h3>{featuredMessage.title}</h3>
            <p class="home-media-meta">{featuredMessage.series} / {featuredMessage.speaker} / {featuredMessage.duration}</p>
            <p>{featuredMessage.summary}</p>
            <div class="cluster">
              <a class="btn btn-primary" href={withBase('/messages')}>Watch Message</a>
              <a class="editorial-link" href={withBase('/messages')}>See Recent Series</a>
            </div>
          </div>

          <a href={withBase('/messages')} class="home-media-poster">
            <img src={featuredMessage.image} alt={`${featuredMessage.title} message artwork`} loading="lazy" />
            <div class="home-media-overlay"></div>
            <div class="home-media-play">
              <span>Play</span>
            </div>
          </a>
        </div>

        <div class="home-media-rail">
          {recentMessages.map((message) => (
            <article class="home-media-item">
              <div class="home-media-item-image">
                <img src={message.image} alt={`${message.title} message artwork`} loading="lazy" />
                <div class="home-media-item-overlay"></div>
              </div>
              <div class="home-media-item-copy">
                <p class="home-item-label">{message.series}</p>
                <h3>{message.title}</h3>
                <p>{message.summary}</p>
                <a href={withBase('/messages')} class="editorial-link">Watch Message</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section surface-dark home-mission-band">
      <OutlineGraphic src="/brand/mission/outline-05.png" className="home-outline home-outline-mission" />
      <div class="container home-mission-shell" data-rail-shell>
        <div class="home-mission-copy">
          <p class="home-label home-label-light">Limitless Church</p>
          <h2 class="home-mission-statement">
            "Our mission is to help <span class="home-sticker">people</span> encounter God, love people, and find purpose."
          </h2>
        </div>

        <div class="home-values-head">
          <div class="stack-sm">
            <h3 class="home-values-title">Our Values</h3>
            <p class="home-values-copy">Our core values shape how we serve, lead, and follow Jesus together.</p>
          </div>
          <div class="home-rail-controls">
            <button type="button" class="home-rail-button" data-rail-prev aria-label="Scroll values left">←</button>
            <button type="button" class="home-rail-button" data-rail-next aria-label="Scroll values right">→</button>
          </div>
        </div>

        <div class="home-values-rail" data-home-rail data-scroll-rail>
          {featuredValues.map((value, index) => (
            <article class="home-value-item">
              <div class="home-value-rule"></div>
              <div class="home-value-number">{String(index + 1).padStart(2, '0')}</div>
              <h4>{value.title}</h4>
              <p>{value.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section surface-soft home-doorway-band">
      <div class="container home-doorway-shell">
        <div class="home-doorway-head">
          <div class="stack-sm">
            <p class="home-label">Ways To Connect</p>
            <h2 class="home-display home-display-dark home-doorway-title">Ways to connect beyond Sunday.</h2>
          </div>
          <a href={withBase('/next-steps')} class="editorial-link">Explore More Ways To Connect</a>
        </div>

        <div class="home-doorway-grid">
          {ministryLinks.map((ministry) => (
            <a href={withBase(ministry.href)} class="home-doorway-card">
              <img src={ministry.image} alt={`${ministry.title} ministry`} loading="lazy" />
              <div class="home-doorway-overlay"></div>
              <div class="home-doorway-copy">
                <p class="home-item-label">{ministry.audience}</p>
                <h3>{ministry.title}</h3>
                <p>{ministry.description}</p>
                <span class="editorial-link">{ministry.cta}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section surface-dark home-pastor-band">
      <div class="container home-pastor-shell">
        <OutlineGraphic src="/brand/mission/outline-01.png" className="home-outline home-outline-pastor" />

        <div class="home-pastor-head">
          <p class="home-label home-label-light">Leadership</p>
          <h2 class="home-pastor-title">Our Pastors</h2>
        </div>

        <div class="home-pastor-feature">
          <a href={withBase('/about')} class="home-pastor-portrait">
            <img src={leadPastor.image} alt={`Portrait of Pastor ${leadPastor.name}`} loading="lazy" />
            <div class="home-pastor-overlay"></div>
            <div class="home-pastor-mark">
              <span>Stone + Madison Moss</span>
            </div>
          </a>

          <div class="home-pastor-copy">
            <p class="home-pastor-lead">
              Pastor Stone leads with bold faith, big vision, and a heart to see Nixa transformed by the power of Jesus.
            </p>
            <p class="home-pastor-body">
              Alongside his wife Madison and their children, Stone is helping build a church culture marked by faith,
              family, and a belief that there is more ahead.
            </p>
            <p class="home-pastor-body">
              His teaching is practical, biblical, and focused on real life. Limitless exists to help people encounter
              God, love people, and find purpose together.
            </p>
            <div class="cluster">
              <a class="editorial-link editorial-link-light" href={withBase('/about')}>Read More</a>
              <a class="editorial-link editorial-link-light" href={withBase('/messages')}>Watch A Message</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section home-final-band">
      <div class="container home-final-shell">
        <OutlineGraphic src="/brand/mission/outline-02.png" className="home-outline home-outline-final" />
        <p class="home-label home-label-light">Ready For Sunday?</p>
        <h2 class="home-final-title">Start your Sunday with confidence.</h2>
        <p class="home-final-copy">
          We will help with parking, kids check-in, and anything else you need so your first visit feels easy.
        </p>
        <div class="cluster">
          <a class="btn btn-primary" href={withBase('/plan-your-visit')}>Get Sunday Details</a>
          <a class="editorial-link" href={withBase('/kids')}>What About Kids?</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home-page {
    background:
      linear-gradient(180deg, #faf6f0 0%, #eef3f8 38%, #f9fafb 100%);
  }

  .home-hero-wrap {
    padding: 0;
  }

  .home-label {
    color: var(--accent-strong);
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .home-label-light {
    color: #dfe7f5;
  }

  .home-display {
    color: var(--text);
    font-size: clamp(2.25rem, 4.8vw, 4.6rem);
    line-height: 0.92;
    max-width: 11ch;
    text-wrap: balance;
  }

  .home-display-dark {
    color: var(--ink);
  }

  .home-item-label-dark {
    color: #335ea7;
  }

  .home-visit-title {
    font-size: clamp(1.95rem, 3.2vw, 3rem);
    line-height: 0.96;
    max-width: 8.8ch;
  }

  .home-media-title,
  .home-doorway-title {
    max-width: 10ch;
  }

  .home-sticker {
    display: inline-block;
    padding: 0.14em 0.42em 0.06em;
    background: #ffffff;
    color: #0d1219;
    border-radius: 0.08rem;
    transform: rotate(-4deg) translateY(-0.05em);
    box-shadow: 0 12px 26px rgba(0, 0, 0, 0.16);
  }

  .home-sticker-light {
    background: #f4f7fc;
  }

  .editorial-link-light {
    color: #ffffff;
  }

  .home-outline {
    position: absolute;
    z-index: 0;
  }

  .home-visit-band {
    background:
      linear-gradient(180deg, #fbf7f1 0%, #eef3f8 100%);
    padding-top: clamp(4rem, 8vw, 6rem);
  }

  .home-visit-shell,
  .home-media-shell,
  .home-mission-shell,
  .home-doorway-shell {
    position: relative;
    z-index: 1;
  }

  .home-visit-shell {
    display: grid;
    gap: 1.35rem;
  }

  .home-visit-head {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 0.72fr);
    gap: 2.4rem;
    align-items: start;
  }

  .home-visit-copy,
  .home-address {
    color: #556277;
    font-size: 1rem;
  }

  .home-visit-copy {
    max-width: 32ch;
    padding-top: 0.45rem;
    line-height: 1.5;
  }

  .home-visit-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.2rem;
  }

  .home-toolbar-note {
    color: #6a7482;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .home-rail-controls-dark .home-rail-button-dark {
    background: #0b1017;
    color: #f4f7fc;
  }

  .home-visit-rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(18rem, 22rem);
    gap: 0.9rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    align-items: stretch;
    padding-bottom: 0.5rem;
    scroll-snap-type: x proximity;
    cursor: grab;
  }

  .home-visit-rail:active {
    cursor: grabbing;
  }

  .home-visit-rail::-webkit-scrollbar {
    height: 0.45rem;
  }

  .home-visit-rail::-webkit-scrollbar-thumb {
    background: rgba(13, 18, 25, 0.18);
    border-radius: 999px;
  }

  .home-visit-slide {
    position: relative;
    min-height: 19.5rem;
    display: grid;
    scroll-snap-align: start;
    overflow: hidden;
    isolation: isolate;
  }

  .home-visit-slide-copy {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.75rem;
    align-content: end;
    min-height: 100%;
    padding: 1.1rem;
  }

  .home-visit-slide h3 {
    font-size: clamp(1.45rem, 2.2vw, 2.3rem);
    line-height: 0.96;
    max-width: 11ch;
  }

  .home-visit-slide p,
  .home-visit-slide li {
    font-size: 0.96rem;
    line-height: 1.45;
  }

  .home-visit-slide-primary {
    min-width: min(24rem, 66vw);
    background:
      radial-gradient(circle at 75% 25%, rgba(66, 121, 255, 0.22), transparent 28%),
      linear-gradient(180deg, #0a0e15 0%, #05080d 100%);
    color: #f4f7fc;
  }

  .home-visit-slide-light {
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 14px 24px rgba(10, 15, 24, 0.04);
  }

  .home-visit-slide-image,
  .home-visit-slide-event {
    background: #0b1118;
    color: #f4f7fc;
  }

  .home-visit-slide-image img,
  .home-visit-slide-event img,
  .home-visit-slide-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .home-visit-slide-image img,
  .home-visit-slide-event img {
    object-fit: cover;
  }

  .home-visit-slide-overlay {
    background:
      linear-gradient(180deg, rgba(7, 10, 16, 0.1) 0%, rgba(7, 10, 16, 0.26) 40%, rgba(7, 10, 16, 0.9) 100%);
  }

  .home-time-list {
    display: grid;
    gap: 0.38rem;
    color: #ffffff;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: clamp(1.15rem, 1.8vw, 1.5rem);
    line-height: 0.96;
    text-transform: uppercase;
  }

  .home-visit-support {
    color: #b8c8df;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-visit-bullets {
    display: grid;
    gap: 0.7rem;
    color: #425063;
  }

  .home-visit-bullets li {
    position: relative;
    padding-left: 1rem;
  }

  .home-visit-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6rem;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: #2e63ff;
  }

  .home-visit-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.2rem;
  }

  .home-media-band {
    background:
      radial-gradient(circle at 82% 18%, rgba(61, 116, 255, 0.14), transparent 24%),
      linear-gradient(180deg, #0b1017 0%, #05080d 100%);
    overflow: hidden;
  }

  .home-media-shell {
    display: grid;
    gap: 1.45rem;
  }

  .home-outline-media {
    right: -10rem;
    top: 1.5rem;
    width: 30rem;
    height: 20rem;
    opacity: 0.14;
    --outline-rotate: 3deg;
  }

  .home-media-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.2rem;
    align-items: end;
  }

  .home-media-feature {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    gap: 1.35rem;
    align-items: end;
  }

  .home-media-copy {
    display: grid;
    gap: 0.9rem;
    align-content: end;
    max-width: 31rem;
  }

  .home-media-copy h3 {
    color: var(--text);
    font-size: clamp(2rem, 4vw, 3.8rem);
    line-height: 0.92;
    max-width: 9ch;
  }

  .home-media-copy p {
    color: var(--text-muted);
    max-width: 36ch;
  }

  .home-media-meta {
    color: #7da9ff;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .home-media-poster {
    position: relative;
    min-height: clamp(18rem, 36vw, 30rem);
    overflow: hidden;
    background: #060a10;
  }

  .home-media-poster img,
  .home-media-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .home-media-poster img {
    object-fit: cover;
  }

  .home-media-overlay {
    background:
      linear-gradient(180deg, rgba(6, 10, 16, 0.06) 0%, rgba(6, 10, 16, 0.58) 100%);
  }

  .home-media-play {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: #ffffff;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .home-media-play::before {
    content: '';
    width: 2.7rem;
    height: 2.7rem;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.72);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0.04) 100%);
  }

  .home-media-play::after {
    content: '';
    position: absolute;
    left: 1.12rem;
    top: 50%;
    transform: translateY(-50%);
    border-top: 0.34rem solid transparent;
    border-bottom: 0.34rem solid transparent;
    border-left: 0.5rem solid #ffffff;
  }

  .home-media-rail {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .home-media-item {
    display: grid;
    grid-template-columns: minmax(9rem, 0.75fr) minmax(0, 1fr);
    min-height: 13rem;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .home-media-item-image {
    position: relative;
    overflow: hidden;
  }

  .home-media-item-image img,
  .home-media-item-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .home-media-item-image img {
    object-fit: cover;
  }

  .home-media-item-overlay {
    background: linear-gradient(180deg, rgba(7, 10, 16, 0.04) 0%, rgba(7, 10, 16, 0.56) 100%);
  }

  .home-media-item-copy {
    display: grid;
    gap: 0.75rem;
    align-content: end;
    padding: 0.35rem 0 0.2rem;
  }

  .home-media-item-copy h3 {
    color: var(--text);
    font-size: 1.65rem;
    line-height: 0.96;
  }

  .home-media-item-copy p {
    color: var(--text-muted);
  }

  .home-item-label {
    color: #8eb3ff;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .home-mission-band {

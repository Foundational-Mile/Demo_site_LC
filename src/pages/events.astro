---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import SectionIntro from '../components/SectionIntro.astro';
import EventCard from '../components/EventCard.astro';
import CTABand from '../components/CTABand.astro';
import CardGrid from '../components/CardGrid.astro';
import { events } from '../data/content';

const featured = events.find((event) => event.featured) ?? events[0];
const upcoming = events.filter((event) => event.title !== featured.title);
const categories = ['All', 'Worship', 'Next Step', 'Family', 'Youth', 'Groups'];
---

<BaseLayout title="Events | Limitless Church">
  <div class="page-field">
    <HeroSection
      eyebrow="Events"
      title="See What’s Coming Up"
      text="Find upcoming gatherings like First Wednesday, baptism, and New Here Party."
      centered={true}
      textured={true}
      graphic="flame"
      primaryCta={{ label: 'See Upcoming Events', href: '#upcoming' }}
      secondaryCta={{ label: 'See Visit Info', href: '/plan-your-visit' }}
    />

    <section class="section page-section surface-dark events-feature-band">
      <div class="container">
        <div class="page-module page-module-white page-module-stack events-feature-shell">
          <SectionIntro
            eyebrow="Featured Event"
            title={featured.title}
            text={featured.description}
          />
          <EventCard {...featured} featured={true} />
        </div>
      </div>
    </section>

    <section id="upcoming" class="section page-section surface-soft events-upcoming-band">
      <div class="container">
        <div class="page-module page-module-soft page-module-stack events-upcoming-shell">
          <SectionIntro
            eyebrow="Upcoming"
            title="Plan ahead and bring someone with you"
            text="Browse by event type and lock in your next date."
          />
          <div class="cluster filter-row" aria-label="Event category filters preview">
            {categories.map((category, index) => (
              <button class={`filter-pill ${index === 0 ? 'active' : ''}`} type="button">{category}</button>
            ))}
          </div>
          <CardGrid columns={3}>
            {upcoming.map((event) => (
              <EventCard {...event} />
            ))}
          </CardGrid>
        </div>
      </div>
    </section>

    <CTABand
      eyebrow="Stay In The Loop"
      title="Never miss an important date"
      text="Check back often for new event details and next-step opportunities for your family."
      primary={{ label: 'Open Event Calendar', href: '#upcoming' }}
      secondary={{ label: 'Plan A Visit', href: '/plan-your-visit' }}
    />
  </div>
</BaseLayout>

<style>
  .events-feature-shell,
  .events-upcoming-shell {
    position: relative;
  }

  .filter-row {
    gap: 0.55rem;
    padding-bottom: 0.25rem;
  }

  .filter-pill {
    border: 1px solid rgba(13, 18, 25, 0.14);
    background: rgba(255, 255, 255, 0.9);
    color: #46536a;
    font-weight: 700;
    padding: 0.55rem 0.82rem;
    border-radius: 999px;
    cursor: pointer;
    font-family: 'Barlow Condensed', sans-serif;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .filter-pill.active {
    border-color: rgba(16, 18, 24, 0.28);
    color: #0f1115;
    background: #eceff4;
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import SectionIntro from '../components/SectionIntro.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import CTABand from '../components/CTABand.astro';
import OutlineGraphic from '../components/OutlineGraphic.astro';
import { giveFaqs, impactHighlights } from '../data/content';
import { media } from '../data/media';
---

<BaseLayout title="Give | Limitless Church">
  <div class="page-field">
    <HeroSection
      eyebrow="Give"
      title="Give With Confidence"
      text="Your generosity helps people encounter God, love people, and find purpose."
      graphic="flame"
      image={media.heroes.give}
      imageAlt="People serving community together"
      primaryCta={{ label: 'Give Online', href: '#giving-faq' }}
      secondaryCta={{ label: 'Giving FAQ', href: '#giving-faq' }}
    />

    <section class="section page-section surface-dark give-why-band">
      <div class="container">
        <div class="split page-module page-module-ink page-module-split give-why-shell">
          <div class="stack-lg">
            <SectionIntro
              eyebrow="Why We Give"
              title="Generosity builds what matters most"
              text="At Limitless Church, every gift fuels ministry and helps people take real steps in faith."
            />
            <ul class="list-check">
              <li>Weekend ministry and discipleship environments</li>
              <li>Kids and student investment for the next generation</li>
              <li>Local outreach and compassion projects</li>
              <li>Practical support for people and families in our community</li>
            </ul>
          </div>
          <article class="stewardship-card">
            <h3>Stewardship + Trust</h3>
            <p>
              Limitless Church is a registered non-profit, and giving statements are provided annually. We are committed to
              stewarding every dollar with integrity.
            </p>
            <a class="editorial-link" href="#giving-faq">View Stewardship FAQ</a>
          </article>
        </div>
      </div>
    </section>

    <section class="section page-section surface-soft give-impact-band">
      <div class="container">
        <div class="page-module page-module-soft page-module-stack impact-shell">
          <OutlineGraphic src="/brand/mission/outline-03.png" className="impact-outline" />
          <SectionIntro
            eyebrow="Impact"
            title="What your generosity makes possible"
            text="Here are a few examples of where giving is currently making a difference."
          />
          <div class="grid grid-3">
            {impactHighlights.map((item) => (
              <article class="impact-card">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="giving-faq" class="section page-section give-faq-band">
      <div class="container">
        <div class="split page-module page-module-white page-module-split give-faq-shell">
          <div class="stack-lg">
            <SectionIntro
              eyebrow="Giving FAQ"
              title="Common questions"
              text="Simple answers to help you give with confidence."
            />
            <FAQAccordion items={giveFaqs} />
          </div>
          <CTABand
            embedded={true}
            dark={false}
            title="Ready to give?"
            text="Thank you for investing in what God is doing through Limitless Church."
            primary={{ label: 'Open Giving Portal', href: '/give#giving-faq' }}
            secondary={{ label: 'Set Up Recurring', href: '/give#giving-faq' }}
          />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .stewardship-card,
  .impact-card {
    padding: 1.2rem;
    display: grid;
    gap: 0.7rem;
  }

  .give-why-shell,
  .give-faq-shell,
  .impact-shell {
    position: relative;
  }

  .impact-shell {
    position: relative;
    overflow: hidden;
  }

  .impact-outline {
    right: -3rem;
    top: -1.5rem;
    width: 18rem;
    height: 12rem;
    opacity: 0.12;
  }

  .stewardship-card p,
  .impact-card p {
    color: #55647d;
  }

  .stewardship-card .editorial-link {
    color: var(--text);
  }

  .stewardship-card {
    background: rgba(255, 255, 255, 0.06);
    border-top: 4px solid rgba(125, 169, 255, 0.18);
  }

  .impact-card {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(246, 243, 238, 0.88) 100%);
    border-top: 4px solid rgba(23, 92, 216, 0.18);
  }
</style>

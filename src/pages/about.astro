---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import SectionIntro from '../components/SectionIntro.astro';
import CTABand from '../components/CTABand.astro';
import CardGrid from '../components/CardGrid.astro';
import TestimonialStrip from '../components/TestimonialStrip.astro';
import OutlineGraphic from '../components/OutlineGraphic.astro';
import { values, beliefs, staff, testimonials } from '../data/content';
import { media } from '../data/media';
import { withBase } from '../utils/paths';

const leadPastor = staff[0];
---

<BaseLayout title="About | Limitless Church">
  <div class="page-field">
    <HeroSection
      eyebrow="Who We Are"
      title="A Life-Giving Church In Nixa, Missouri"
      text="Limitless Church exists to help people encounter God, love people, and find purpose."
      graphic="dove"
      image={media.heroes.about}
      imageAlt="Church lobby with people connecting"
      primaryCta={{ label: 'Plan Your Visit', href: '/plan-your-visit' }}
      secondaryCta={{ label: 'Read Our Values', href: '/about-values' }}
    />

    <section class="section page-section surface-dark about-pastor-band">
      <div class="container">
        <div class="split page-module page-module-ink page-module-split about-pastor-shell">
          <OutlineGraphic src="/brand/mission/outline-01.png" className="about-outline about-outline-pastor" />
          <div class="stack-lg">
            <SectionIntro
              eyebrow="Pastor Stone Moss"
              title="Bold Faith. Big Vision. Real Local Impact."
              text="Pastor Stone leads with a heart to see Nixa transformed by the power of a limitless God."
            />
            <p class="lead">
              Alongside his wife Madison and their children, Stone is helping build a church culture marked by faith,
              family, and a belief that there is more ahead. His teaching is practical, biblical, and focused on real life.
            </p>
            <div class="cluster">
              <a class="btn btn-secondary" href={withBase('/staff')}>Meet Our Team</a>
              <a class="btn btn-ghost" href={withBase('/messages')}>Watch A Message</a>
            </div>
          </div>
          <div class="lead-pastor-card">
            <img
              class="media-cover"
              src={leadPastor.image}
              alt="Portrait of Pastor Stone Moss"
              loading="lazy"
            />
            <div class="stack-sm content">
              <h3>{leadPastor.name}</h3>
              <p class="role">{leadPastor.role}</p>
              <p>{leadPastor.bio}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section page-section about-values-band">
      <div class="container">
        <div class="page-module page-module-soft page-module-stack about-values-shell">
          <SectionIntro
            eyebrow="Our Values"
            title="How We Live And Lead"
            text="These values shape our culture, our teams, and how we serve people every week."
          />
          <CardGrid columns={4}>
            {values.slice(0, 4).map((value) => (
              <article class="card value-card">
                <h3>{value.title}</h3>
                <p>{value.description}</p>
              </article>
            ))}
          </CardGrid>
          <a class="btn btn-secondary" href={withBase('/about-values')}>View All 8 Values</a>
        </div>
      </div>
    </section>

    <section class="section page-open-section surface-dark about-mission-band">
      <div class="container split">
        <article class="statement-card">
          <h3>Our Mission</h3>
          <p>
            We exist to help people experience the presence of God, build authentic relationships, and step into divine purpose.
          </p>
        </article>
        <article class="statement-card">
          <h3>Our Vision: There Is More</h3>
          <p>
            We believe God has more hope, more purpose, and more life ahead for every person, every family, and our city.
          </p>
        </article>
      </div>
    </section>

    <section class="section page-section about-essentials-band">
      <div class="container">
        <div class="page-module page-module-white page-module-stack about-essentials-shell">
          <SectionIntro
            eyebrow="The Essentials"
            title="Core Biblical Convictions"
            text="These core essentials guide our doctrine, teaching, and discipleship."
          />
          <div class="grid grid-2">
            {beliefs.slice(0, 4).map((belief) => (
              <article class="card belief-card">
                <h3>{belief.heading}</h3>
                <p>{belief.text}</p>
              </article>
            ))}
          </div>
          <a class="btn btn-secondary" href={withBase('/about-essentials')}>Explore All Essentials</a>
        </div>
      </div>
    </section>

    <TestimonialStrip items={testimonials} title="Why people call Limitless home" />

    <CTABand
      eyebrow="Join Us This Weekend"
      title="Come experience Limitless in person."
      text="Whether you are exploring faith or looking for a church home, we would love to welcome you."
      primary={{ label: 'Get Sunday Details', href: '/plan-your-visit' }}
      secondary={{ label: 'Explore Next Steps', href: '/next-steps' }}
    />
  </div>
</BaseLayout>

<style>
  .about-pastor-shell,
  .about-values-shell,
  .about-essentials-shell {
    position: relative;
  }

  .about-outline {
    position: absolute;
    pointer-events: none;
  }

  .about-outline-pastor {
    left: -6rem;
    top: 0;
    width: 18rem;
    height: 14rem;
    opacity: 0.12;
    --outline-rotate: -5deg;
  }

  .value-card,
  .belief-card,
  .statement-card,
  .lead-pastor-card .content {
    padding: 1.05rem;
  }

  .value-card,
  .belief-card,
  .statement-card {
    display: grid;
    gap: 0.6rem;
  }

  .lead-pastor-card {
    overflow: hidden;
    background: rgba(255, 255, 255, 0.06);
    border-top: 4px solid rgba(125, 169, 255, 0.18);
  }

  .lead-pastor-card .role {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #8eb3ff;
    font-weight: 700;
  }

  .value-card p,
  .belief-card p,
  .statement-card p,
  .lead-pastor-card p {
    color: #55647d;
  }

  .statement-card {
    background: rgba(255, 255, 255, 0.05);
    border-top: 4px solid rgba(255, 255, 255, 0.2);
  }

  .statement-card h3 {
    color: var(--text);
  }

  .statement-card p,
  .lead-pastor-card p {
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .about-outline-pastor {
      left: -3rem;
      width: 11rem;
      height: 8rem;
    }
  }
</style>

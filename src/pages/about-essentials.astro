---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import SectionIntro from '../components/SectionIntro.astro';
import CTABand from '../components/CTABand.astro';
import OutlineGraphic from '../components/OutlineGraphic.astro';
import { beliefs } from '../data/content';
---

<BaseLayout title="The Essentials | Limitless Church">
  <div class="page-field">
    <HeroSection
      eyebrow="The Essentials"
      title="What We Believe"
      text="These biblical essentials shape our doctrine, teaching, and spiritual formation as a church."
      centered={true}
      textured={true}
      primaryCta={{ label: 'Back To About', href: '/about' }}
      secondaryCta={{ label: 'Read Our Values', href: '/about-values' }}
    />

    <section class="section page-section surface-soft essentials-band">
      <div class="container">
        <div class="essentials-shell">
          <OutlineGraphic src="/brand/mission/outline-05.png" className="essentials-outline" />
          <SectionIntro
            eyebrow="Doctrine"
            title="Core Convictions"
            text="Each essential below summarizes a foundational belief we hold with clarity and conviction."
          />
          <div class="grid grid-2 essentials-grid">
            {beliefs.map((belief) => (
              <article class="card essential-card">
                <h3>{belief.heading}</h3>
                <p>{belief.text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <CTABand
      eyebrow="Questions?"
      title="Want to talk through what we believe?"
      text="Our pastors would love to help you process faith, scripture, and next steps."
      primary={{ label: 'Contact Our Team', href: '/care' }}
      secondary={{ label: 'Plan Your Visit', href: '/plan-your-visit' }}
    />
  </div>
</BaseLayout>

<style>
  .essentials-shell {
    position: relative;
    display: grid;
    gap: 2rem;
  }

  .essentials-outline {
    width: min(22rem, 32vw);
    height: min(22rem, 32vw);
    left: auto;
    right: -2.5rem;
    top: 8rem;
    opacity: 0.12;
  }

  .essentials-grid {
    gap: 1rem;
  }

  .essential-card {
    padding: 1.05rem;
    display: grid;
    gap: 0.6rem;
    border-top: 3px solid rgba(42, 111, 232, 0.55);
  }

  .essential-card p {
    color: #55647d;
  }

  @media (max-width: 980px) {
    .essentials-outline {
      width: 14rem;
      height: 14rem;
      top: auto;
      bottom: 3rem;
      right: -1.5rem;
    }
  }
</style>

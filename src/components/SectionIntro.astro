---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  centered?: boolean;
}

const { eyebrow, title, text, centered = false } = Astro.props;
---

<div class={`stack section-intro ${centered ? 'centered' : ''}`}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h2 class="title-lg">{title}</h2>
  {text && <p class="lead">{text}</p>}
</div>

<style>
  .section-intro {
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    max-width: 46rem;
    position: relative;
  }

  .section-intro h2 {
    max-width: 14ch;
    font-size: clamp(1.8rem, 3vw, 3rem);
    line-height: 0.94;
    text-wrap: balance;
    position: relative;
    display: inline-block;
    padding-bottom: 0.6rem;
  }

  .section-intro h2::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: clamp(3rem, 8vw, 5rem);
    height: 0.14rem;
    background: linear-gradient(90deg, var(--accent) 0%, rgba(45, 120, 255, 0.18) 100%);
    border-radius: 999px;
  }

  .section-intro .lead {
    max-width: 38ch;
    font-size: clamp(0.98rem, 1vw + 0.78rem, 1.08rem);
  }

  .centered {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    justify-items: center;
  }

  .centered h2,
  .centered .lead {
    max-width: 18ch;
  }

  .centered h2::after {
    left: 50%;
    transform: translateX(-50%);
  }
</style>

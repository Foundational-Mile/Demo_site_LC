---
import { withBase } from '../utils/paths';
import OutlineGraphic from './OutlineGraphic.astro';

interface Props {
  eyebrow?: string;
  title: string;
  text: string;
  image?: string;
  imageAlt?: string;
  videoPreview?: boolean;
  videoLabel?: string;
  videoHref?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  serviceTimes?: string[];
  location?: string;
  centered?: boolean;
  textured?: boolean;
  graphic?: 'praying-hands' | 'open-bible' | 'cross' | 'dove' | 'flame' | 'worship-hands' | 'abstract-wave';
}

const {
  eyebrow,
  title,
  text,
  image = '',
  imageAlt = '',
  videoPreview = false,
  videoLabel = 'Welcome Video',
  videoHref = '/messages',
  primaryCta,
  secondaryCta,
  serviceTimes = [],
  location,
  centered = false,
  textured = false,
  graphic = 'abstract-wave'
} = Astro.props;

const hasMedia = Boolean(image);
---

<section class="hero section page-section">
  <div class={`hero-shell surface-dark ${textured ? 'textured' : ''}`}>
    <OutlineGraphic variant={graphic} className="hero-outline hero-outline-primary" />
    <div class="container">
      <div class={`hero-grid ${centered ? 'centered' : ''} ${!hasMedia ? 'no-media' : ''}`}>
        <div class={`stack-lg hero-copy ${centered ? 'centered' : ''}`}>
          {eyebrow && <span class="eyebrow">{eyebrow}</span>}
          <h1 class="title-xl">{title}</h1>
          <p class="lead">{text}</p>

          {(primaryCta || secondaryCta) && (
            <div class="cluster hero-actions">
              {primaryCta && <a class="btn btn-primary" href={withBase(primaryCta.href)}>{primaryCta.label}</a>}
              {secondaryCta && <a class="editorial-link hero-editorial-link" href={withBase(secondaryCta.href)}>{secondaryCta.label}</a>}
            </div>
          )}

          {(serviceTimes.length > 0 || location) && (
            <div class="hero-meta">
              {serviceTimes.length > 0 && (
                <article>
                  <h2>Service Times</h2>
                  <ul>
                    {serviceTimes.map((time) => (
                      <li>{time}</li>
                    ))}
                  </ul>
                </article>
              )}
              {location && (
                <article>
                  <h2>Location</h2>
                  <p>{location}</p>
                </article>
              )}
            </div>
          )}
        </div>

        {hasMedia &&
          (videoPreview ? (
            <a class="video-shell" href={withBase(videoHref)} aria-label={videoLabel}>
              <img class="media-cover" src={image} alt={imageAlt} loading="eager" />
              <span class="video-overlay">
                <span class="play-icon" aria-hidden="true">▶</span>
                <span>{videoLabel}</span>
              </span>
            </a>
          ) : (
            <div class="media-card">
              <img class="media-cover" src={image} alt={imageAlt} loading="eager" />
            </div>
          ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 0;
    padding-bottom: 0;
    position: relative;
  }

  .hero-shell {
    position: relative;
    overflow: hidden;
    min-height: clamp(520px, 72vh, 760px);
    padding: clamp(4.8rem, 8vw, 7rem) 0;
  }

  .hero-shell::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 86% 12%, rgba(255, 255, 255, 0.08), transparent 22%),
      linear-gradient(180deg, rgba(7, 10, 15, 0.08), rgba(7, 10, 15, 0.18));
    pointer-events: none;
  }

  .hero-shell.textured {
    background:
      radial-gradient(circle at top right, rgba(45, 120, 255, 0.22), transparent 26%),
      linear-gradient(180deg, #121922 0%, #090e15 100%);
  }

  .hero-outline-primary {
    right: -4rem;
    bottom: -2rem;
    width: clamp(12rem, 26vw, 22rem);
    height: clamp(12rem, 26vw, 22rem);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.9fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .hero-copy {
    max-width: 48rem;
  }

  .hero-grid.no-media {
    grid-template-columns: 1fr;
  }

  .hero-grid.centered {
    justify-items: center;
  }

  .hero-copy.centered {
    max-width: 52rem;
    text-align: center;
    justify-items: center;
  }

  .hero-copy.centered .cluster {
    justify-content: center;
  }

  .hero-copy.centered .hero-meta {
    width: min(760px, 100%);
  }

  .hero-copy .title-xl {
    max-width: 9ch;
  }

  .hero-meta {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .hero-meta > article {
    padding: 1rem 1.05rem;
    border-radius: 1.2rem;
    background: rgba(255, 255, 255, 0.04);
  }

  .hero-meta h2 {
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 0.45rem;
  }

  .hero-meta ul,
  .hero-meta p {
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .media-card,
  .video-shell {
    position: relative;
    display: block;
    border-radius: 0;
    overflow: hidden;
    background: transparent;
    box-shadow: none;
  }

  .media-card::after,
  .video-shell::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(7, 10, 15, 0.02), rgba(7, 10, 15, 0.42));
    pointer-events: none;
  }

  .media-card .media-cover,
  .video-shell img {
    aspect-ratio: 4 / 4.6;
    border-radius: 0;
  }

  .video-overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 0.8rem;
    justify-items: center;
    color: #ffffff;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .play-icon {
    width: 3.6rem;
    height: 3.6rem;
    border-radius: 999px;
    display: grid;
    place-items: center;
    font-size: 1rem;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.28);
    backdrop-filter: blur(4px);
  }

  .hero-editorial-link {
    color: var(--text);
  }

  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-copy .title-xl {
      max-width: 11ch;
    }

    .media-card .media-cover,
    .video-shell img {
      aspect-ratio: 16 / 10;
    }
  }

  @media (max-width: 700px) {
    .hero-shell {
      min-height: auto;
      padding: 4.7rem 0 4rem;
    }

    .hero-meta {
      grid-template-columns: 1fr;
    }

    .hero-outline-primary {
      right: -2rem;
      bottom: 1rem;
      width: 10rem;
      height: 10rem;
      opacity: 0.14;
    }
  }
</style>

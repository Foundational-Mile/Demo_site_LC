---
import { withBase } from '../utils/paths';

interface Props {
  eyebrow?: string;
  title?: string;
  text?: string;
  leftPillars?: string[];
  contained?: boolean;
  poster: string;
  videoAlt: string;
  videoSrc?: string;
  staticOnly?: boolean;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  serviceSummary?: string;
  location?: string;
}

const {
  eyebrow,
  title = '',
  text = '',
  leftPillars = [],
  contained = false,
  poster,
  videoAlt,
  videoSrc = '/videos/hero-home.mp4',
  staticOnly = false,
  primaryCta,
  secondaryCta,
  serviceSummary,
  location
} = Astro.props;

const resolvedPoster = withBase(poster);
const resolvedVideoSrc = withBase(videoSrc);
const hasFrame = Boolean(serviceSummary || location);
const hasPrimaryCopy = Boolean(leftPillars.length || eyebrow || title);
const hasSupportCopy = Boolean(text || primaryCta || secondaryCta);
---

<section
  class={`full-hero surface-dark ${contained ? 'contained' : ''} ${staticOnly ? 'static-hero' : ''}`}
  aria-label="Homepage hero"
  style={`--hero-poster-url: url("${resolvedPoster}")`}
>
  <div class="hero-main">
    <div class="hero-media">
      {staticOnly ? (
        <img class="hero-image" src={resolvedPoster} alt={videoAlt} loading="eager" />
      ) : (
        <video class="hero-video" autoplay muted loop playsinline poster={resolvedPoster} preload="metadata" aria-label={videoAlt}>
          <source src={resolvedVideoSrc} type="video/mp4" />
        </video>
      )}
      <div class="hero-scrim"></div>
    </div>

    <div class="hero-content">
      <div class="container hero-layout">
        <div class="hero-copy-wrap">
          {hasPrimaryCopy && (
            leftPillars.length > 0 ? (
              <div class="pillar-wrap" aria-label="Faith pillars">
                <h1 class="pillar-heading">
                  {leftPillars.map((pillar) => (
                    <span class="pillar-line">{pillar}</span>
                  ))}
                </h1>
              </div>
            ) : (
              <div class="stack hero-stack hero-primary-copy">
                {eyebrow && <span class="eyebrow">{eyebrow}</span>}
                {title && <h1 class="title-xl">{title}</h1>}
              </div>
            )
          )}

          {hasSupportCopy && (
            <div class="stack hero-stack hero-support">
              {eyebrow && leftPillars.length > 0 && <span class="eyebrow">{eyebrow}</span>}
              {title && leftPillars.length > 0 && <p class="hero-kicker">{title}</p>}
              {text && <p class="lead">{text}</p>}

              {(primaryCta || secondaryCta) && (
                <div class="cluster hero-actions">
                  {primaryCta && <a class="btn btn-primary" href={withBase(primaryCta.href)}>{primaryCta.label}</a>}
                  {secondaryCta && <a class="btn btn-secondary" href={withBase(secondaryCta.href)}>{secondaryCta.label}</a>}
                </div>
              )}
            </div>
          )}
        </div>
      </div>
    </div>
  </div>

  {hasFrame && (
    <div class={`hero-frame ${staticOnly ? 'hero-frame-static' : ''}`}>
      <div class="container frame-inner">
        {serviceSummary && (
          <p>
            <strong>Service Times</strong>
            <span>{serviceSummary}</span>
          </p>
        )}
        {location && (
          <p>
            <strong>Location</strong>
            <span>{location}</span>
          </p>
        )}
      </div>
    </div>
  )}

  <div class="sr-only">
    {title}
    {text}
  </div>

  {!staticOnly && (
    <p class="video-fallback-note" aria-live="polite">
      Showing a static hero for smoother playback on this device.
    </p>
  )}
</section>

<style>
  .full-hero {
    position: relative;
    min-height: initial;
  }

  .full-hero.contained {
    border-radius: 1.15rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: var(--shadow-md);
  }

  .hero-main {
    position: relative;
    min-height: clamp(520px, 70vh, 760px);
  }

  .hero-media,
  .hero-video,
  .hero-scrim,
  .hero-content,
  .hero-image {
    position: absolute;
    inset: 0;
  }

  .hero-video,
  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    background: #0f1219;
  }

  .hero-media {
    background-image: var(--hero-poster-url);
    background-position: center;
    background-size: cover;
    background-color: #0f1219;
  }

  .hero-scrim {
    background:
      linear-gradient(90deg, rgba(8, 9, 12, 0.76) 0%, rgba(8, 9, 12, 0.54) 24%, rgba(8, 9, 12, 0.18) 58%, rgba(8, 9, 12, 0.18) 100%),
      linear-gradient(180deg, rgba(8, 9, 12, 0.08) 0%, rgba(8, 9, 12, 0.18) 56%, rgba(8, 9, 12, 0.54) 100%);
  }

  .static-hero .hero-scrim {
    background:
      linear-gradient(90deg, rgba(8, 9, 12, 0.58) 0%, rgba(8, 9, 12, 0.34) 28%, rgba(8, 9, 12, 0.08) 58%, rgba(8, 9, 12, 0.14) 100%),
      linear-gradient(180deg, rgba(8, 9, 12, 0.02) 0%, rgba(8, 9, 12, 0.14) 76%, rgba(8, 9, 12, 0.24) 100%);
  }

  .hero-content {
    display: grid;
    z-index: 1;
  }

  .hero-layout {
    display: grid;
    align-items: end;
    min-height: 100%;
    padding-top: clamp(2rem, 3vw, 2.8rem);
    padding-bottom: clamp(3.75rem, 6vw, 5.25rem);
  }

  .hero-copy-wrap {
    display: grid;
    gap: 1.1rem;
    width: min(100%, 30rem);
    max-width: 30rem;
  }

  .hero-stack {
    padding-bottom: 0;
    max-width: 52ch;
  }

  .hero-primary-copy {
    width: min(100%, 30rem);
  }

  .pillar-wrap {
    width: min(100%, 12ch);
    max-width: 12ch;
  }

  .pillar-heading {
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }

  .pillar-line {
    display: block;
    font-family: 'Barlow Condensed', 'Barlow', sans-serif;
    font-size: clamp(2.3rem, 4.8vw, 4.25rem);
    font-style: italic;
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: 0.02em;
    color: #f4f7fc;
    text-shadow: 0 5px 22px rgba(0, 0, 0, 0.34);
  }

  .hero-support {
    width: min(100%, 21rem);
    max-width: 21rem;
  }

  .hero-kicker {
    margin: 0;
    color: #eef3fb;
    font-size: 1rem;
    line-height: 1.45;
    font-weight: 600;
  }

  .full-hero .lead {
    color: #e4eaf5;
    font-size: 1rem;
    line-height: 1.55;
  }

  .hero-actions {
    width: 100%;
    gap: 0.8rem;
  }

  .hero-actions .btn {
    max-width: 100%;
  }

  @media (min-width: 741px) {
    .hero-support {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 1rem 1.1rem;
      width: min(100%, 30rem);
      max-width: 30rem;
    }

    .hero-support .eyebrow,
    .hero-support .hero-kicker,
    .hero-support .lead {
      grid-column: 1;
    }

    .hero-actions {
      grid-column: 2;
      grid-row: 1 / span 3;
      align-self: center;
      width: auto;
      margin-bottom: 0.5rem;
    }

    .hero-actions .btn {
      white-space: nowrap;
    }
  }

  .hero-frame {
    position: relative;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(10, 12, 17, 0.92);
    backdrop-filter: blur(7px);
    padding: 1rem 0 1.05rem;
  }

  .full-hero.contained .hero-frame,
  .full-hero.contained .hero-frame-static {
    border-top-color: rgba(255, 255, 255, 0.12);
  }

  .frame-inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .frame-inner p {
    margin: 0;
    display: grid;
    gap: 0.18rem;
    color: #e6edf8;
    font-size: 0.94rem;
  }

  .frame-inner strong {
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #5d8ff2;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .video-fallback-note {
    position: absolute;
    right: 0.8rem;
    top: 0.8rem;
    z-index: 2;
    margin: 0;
    display: none;
    padding: 0.45rem 0.65rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #dce6f8;
    background: rgba(7, 10, 18, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(5px);
  }

  .full-hero.fallback-static .video-fallback-note {
    display: inline-flex;
    align-items: center;
  }

  @media (max-width: 740px) {
    .hero-main {
      min-height: 620px;
    }

    .full-hero.contained {
      border-radius: 0.95rem;
    }

    .hero-layout {
      padding-top: 1rem;
      padding-bottom: 1.9rem;
      justify-items: start;
    }

    .hero-copy-wrap {
      width: min(100%, 19.5rem);
      max-width: 19.5rem;
      gap: 1.05rem;
    }

    .hero-scrim {
      background:
        linear-gradient(90deg, rgba(7, 10, 16, 0.6) 0%, rgba(7, 10, 16, 0.32) 26%, rgba(7, 10, 16, 0.08) 56%, rgba(7, 10, 16, 0.18) 100%),
        linear-gradient(180deg, rgba(8, 9, 12, 0.14) 0%, rgba(8, 9, 12, 0.18) 24%, rgba(8, 9, 12, 0.42) 58%, rgba(8, 9, 12, 0.82) 100%);
    }

    .pillar-line {
      font-size: clamp(3rem, 14vw, 4.5rem);
    }

    .hero-support {
      width: min(100%, 16.75rem);
      max-width: 16.75rem;
      display: block;
    }

    .hero-kicker {
      font-size: 0.98rem;
    }

    .hero-support .lead {
      font-size: 0.98rem;
      line-height: 1.48;
      color: rgba(231, 238, 249, 0.92);
    }

    .hero-actions {
      grid-column: auto;
      grid-row: auto;
      margin-top: 0.45rem;
      gap: 0.65rem;
      width: 100%;
    }

    .hero-actions .btn {
      width: 100%;
      justify-content: center;
    }

    .hero-video,
    .hero-image {
      object-position: 62% 28%;
    }

    .frame-inner {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }

    .frame-inner p {
      font-size: 0.88rem;
    }

    .video-fallback-note {
      right: 0.55rem;
      top: 0.55rem;
      font-size: 0.64rem;
      padding: 0.38rem 0.5rem;
    }
  }

  @media (max-width: 420px) {
    .hero-main {
      min-height: 585px;
    }

    .hero-layout {
      padding-top: 0.85rem;
      padding-bottom: 1.8rem;
    }

    .hero-copy-wrap {
      width: min(100%, 17.5rem);
      max-width: 17.5rem;
    }

    .pillar-line {
      font-size: clamp(2.7rem, 13.6vw, 3.6rem);
    }

    .hero-support {
      width: min(100%, 15.75rem);
      max-width: 15.75rem;
    }

    .hero-video,
    .hero-image {
      object-position: 64% 24%;
    }

    .frame-inner strong {
      font-size: 0.68rem;
    }
  }
</style>

<script is:inline>
  const initVideoFallback = () => {
    const heroes = document.querySelectorAll('.full-hero');
    if (heroes.length === 0) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
    const saveData = Boolean(connection && connection.saveData);

    heroes.forEach((hero) => {
      const video = hero.querySelector('.hero-video');
      if (!(video instanceof HTMLVideoElement)) return;

      let hasFallback = false;

      const setFallback = () => {
        if (hasFallback) return;
        hasFallback = true;
        hero.classList.add('fallback-static');
        video.pause();
      };

      if (prefersReducedMotion || saveData) {
        setFallback();
        return;
      }

      video.addEventListener('error', () => setFallback(), { once: true });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVideoFallback, { once: true });
  } else {
    initVideoFallback();
  }
</script>

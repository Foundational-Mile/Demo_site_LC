---
import { withBase } from '../utils/paths';

interface Props {
  eyebrow?: string;
  title?: string;
  text?: string;
  leftPillars?: string[];
  supportEyebrow?: string;
  supportTitle?: string;
  supportMeta?: string;
  contained?: boolean;
  poster: string;
  videoAlt: string;
  videoSrc?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  serviceSummary?: string;
  location?: string;
  supportVisible?: boolean;
}

const {
  eyebrow,
  title = '',
  text = '',
  leftPillars = [],
  supportEyebrow = '',
  supportTitle = '',
  supportMeta = '',
  contained = false,
  poster,
  videoAlt,
  videoSrc = '/videos/hero-home.mp4',
  primaryCta,
  secondaryCta,
  serviceSummary,
  location,
  supportVisible = true
} = Astro.props;

const resolvedPoster = withBase(poster);
const resolvedVideoSrc = withBase(videoSrc);
const hasFrame = Boolean(serviceSummary || location);
---

<section
  class={`full-hero surface-dark ${contained ? 'contained' : ''}`}
  aria-label="Homepage hero"
  style={`--hero-poster-url: url("${resolvedPoster}")`}
>
  <div class="hero-main">
    <div class="hero-media">
      <video class="hero-video" autoplay muted loop playsinline poster={resolvedPoster} preload="metadata" aria-label={videoAlt}>
        <source src={resolvedVideoSrc} type="video/mp4" />
      </video>
      <div class="hero-scrim"></div>
    </div>
    <div class="hero-content">
      <div class="container hero-layout">
        <div class={`hero-grid ${supportVisible ? '' : 'hero-grid-solo'}`}>
          <div class="stack hero-primary">
            {eyebrow && <span class="eyebrow">{eyebrow}</span>}
            {leftPillars.length > 0 ? (
              <h1 class="title-xl pillar-heading">
                {leftPillars.map((pillar) => (
                  <span class="pillar-line">{pillar}</span>
                ))}
              </h1>
            ) : (
              title && <h1 class="title-xl">{title}</h1>
            )}
          </div>

          {supportVisible && (
            <div class="hero-support">
              {supportEyebrow && <p class="hero-support-eyebrow">{supportEyebrow}</p>}
              {supportTitle && <p class="hero-kicker">{supportTitle}</p>}
              {!supportTitle && title && leftPillars.length > 0 && <p class="hero-kicker">{title}</p>}
              {supportMeta && <p class="hero-support-meta">{supportMeta}</p>}
              {text && <p class="lead">{text}</p>}

              {(primaryCta || secondaryCta) && (
                <div class="cluster hero-actions">
                  {primaryCta && <a class="btn btn-primary" href={withBase(primaryCta.href)}>{primaryCta.label}</a>}
                  {secondaryCta && <a class="btn btn-secondary" href={withBase(secondaryCta.href)}>{secondaryCta.label}</a>}
                </div>
              )}
            </div>
          )}
        </div>
      </div>
    </div>
  </div>

  {hasFrame && (
    <div class="hero-frame">
      <div class="container frame-inner">
        {serviceSummary && (
          <article class="hero-detail-card">
            <strong>Sunday Gatherings</strong>
            <span>{serviceSummary}</span>
          </article>
        )}
        {location && (
          <article class="hero-detail-card">
            <strong>Location</strong>
            <span>{location}</span>
          </article>
        )}
      </div>
    </div>
  )}

</section>

<style>
  .full-hero {
    position: relative;
  }

  .full-hero.contained {
    border-radius: 1.9rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: var(--shadow-lg);
  }

  .hero-main {
    position: relative;
    min-height: clamp(520px, 72vh, 760px);
  }

  .full-hero:not(.contained) .hero-main {
    min-height: clamp(560px, 76vh, 820px);
  }

  .hero-media,
  .hero-video,
  .hero-scrim,
  .hero-content {
    position: absolute;
    inset: 0;
  }

  .hero-media {
    background-image: var(--hero-poster-url);
    background-position: center;
    background-size: cover;
    background-color: #0a0f16;
  }

  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #0a0f16;
  }

  .hero-scrim {
    background:
      radial-gradient(circle at 18% 18%, rgba(52, 109, 255, 0.12), transparent 22%),
      linear-gradient(90deg, rgba(5, 8, 13, 0.96) 0%, rgba(5, 8, 13, 0.8) 30%, rgba(5, 8, 13, 0.24) 66%, rgba(5, 8, 13, 0.1) 100%),
      linear-gradient(180deg, rgba(5, 8, 13, 0.08) 0%, rgba(5, 8, 13, 0.22) 44%, rgba(5, 8, 13, 0.9) 100%);
  }

  .hero-content {
    z-index: 1;
  }

  .hero-layout {
    display: grid;
    align-items: end;
    min-height: 100%;
    padding-top: clamp(2.4rem, 5vw, 4rem);
    padding-bottom: clamp(4.8rem, 9vw, 6.8rem);
  }

  .hero-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 24rem);
    align-items: end;
  }

  .hero-grid-solo {
    grid-template-columns: 1fr;
    max-width: 36rem;
  }

  .hero-primary {
    max-width: 10ch;
  }

  .full-hero .eyebrow {
    width: fit-content;
    padding: 0.15rem 0 0.1rem;
    color: #f4f7fc;
  }

  .full-hero .eyebrow::after {
    width: 3.8rem;
    height: 0.14rem;
    background: #7ea9ff;
  }

  .pillar-heading {
    display: grid;
    gap: 0.12rem;
  }

  .pillar-line {
    display: block;
    color: #f4f7fc;
    text-shadow: 0 10px 28px rgba(0, 0, 0, 0.32);
    font-size: clamp(2.4rem, 5.3vw, 4.7rem);
    line-height: 0.9;
  }

  .hero-support {
    padding: 0;
    border-radius: 0;
    background: transparent;
    border: 0;
    backdrop-filter: none;
    box-shadow: none;
  }

  .hero-support-eyebrow {
    color: #8eb3ff;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero-kicker {
    color: #eef3fb;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 1.16rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hero-support-meta {
    color: #b9c7da;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .full-hero .lead {
    color: #e2eaf6;
    max-width: 40ch;
  }

  .hero-actions {
    margin-top: 1.15rem;
  }

  .hero-actions .btn {
    width: auto;
  }

  .hero-frame {
    position: relative;
    margin-top: -2.8rem;
    padding: 0 0 1.5rem;
    background:
      linear-gradient(180deg, rgba(9, 12, 18, 0.96) 0%, rgba(7, 10, 15, 1) 100%);
    border-top: 0;
  }

  .frame-inner {
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
  }

  .hero-detail-card {
    padding: 1.15rem 0 0;
    border-radius: 0;
    background: transparent;
    border: 0;
    border-top: 4px solid rgba(255, 255, 255, 0.94);
    color: #eef3fb;
    display: grid;
    gap: 0.25rem;
  }

  .hero-detail-card strong {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.84rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #7da9ff;
  }

  .hero-detail-card span {
    font-size: 0.98rem;
    max-width: 32ch;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      max-width: 30rem;
    }

    .hero-primary {
      max-width: 8.8ch;
    }

    .hero-grid-solo {
      max-width: 28rem;
    }
  }

  @media (max-width: 740px) {
    .hero-main {
      min-height: 430px;
    }

    .full-hero.contained {
      border-radius: 1.3rem;
    }

    .hero-layout {
      align-items: start;
      padding-top: 1rem;
      padding-bottom: 2.2rem;
    }

    .hero-grid {
      gap: 1rem;
      max-width: 20rem;
    }

    .hero-primary {
      max-width: 8.7ch;
    }

    .hero-support {
      padding: 0;
      border-radius: 0;
    }

    .hero-actions .btn {
      width: 100%;
    }

    .hero-video {
      object-position: 60% 28%;
    }

    .frame-inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 420px) {
    .hero-main {
      min-height: 400px;
    }

    .hero-grid {
      max-width: 18rem;
    }
  }
</style>

---
import { withBase } from '../utils/paths';

interface Props {
  eyebrow?: string;
  title?: string;
  text?: string;
  leftPillars?: string[];
  mobileEyebrow?: string;
  mobileTitle?: string;
  mobileText?: string;
  poster: string;
  mobilePoster?: string;
  videoAlt: string;
  videoSrc?: string;
  staticOnly?: boolean;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  mobilePrimaryCta?: { label: string; href: string };
  mobileSecondaryCta?: { label: string; href: string };
  serviceSummary?: string;
  location?: string;
}

const {
  eyebrow,
  title = '',
  text = '',
  leftPillars = [],
  mobileEyebrow,
  mobileTitle = '',
  mobileText = '',
  poster,
  mobilePoster,
  videoAlt,
  videoSrc = '/videos/hero-home.mp4',
  staticOnly = false,
  primaryCta,
  secondaryCta,
  mobilePrimaryCta,
  mobileSecondaryCta,
  serviceSummary,
  location
} = Astro.props;

const resolvedPoster = withBase(poster);
const resolvedMobilePoster = withBase(mobilePoster ?? poster);
const resolvedVideoSrc = withBase(videoSrc);
const hasFrame = Boolean(serviceSummary || location);
const hasMobileCopy = Boolean(mobileEyebrow || mobileTitle || mobileText || mobilePrimaryCta || mobileSecondaryCta);
---

{staticOnly ? (
  <section
    class="full-hero static-hero surface-dark"
    aria-label="Homepage hero"
    style={`--hero-poster-url: url("${resolvedPoster}"); --hero-mobile-poster-url: url("${resolvedMobilePoster}")`}
  >
    <div class="hero-main">
      <div class="hero-media">
        <img class="hero-image" src={resolvedPoster} alt={videoAlt} loading="eager" />
        <div class="hero-scrim"></div>
      </div>

      <div class="hero-content">
        <div class="container hero-layout">
          {leftPillars.length > 0 ? (
            <div class="pillar-wrap desktop-pillar" aria-label="Faith pillars">
              <h1 class="pillar-heading">
                {leftPillars.map((pillar) => (
                  <span class="pillar-line">{pillar}</span>
                ))}
              </h1>
            </div>
          ) : (eyebrow || title || text || primaryCta || secondaryCta) ? (
            <div class="stack hero-stack">
              {eyebrow && <span class="eyebrow">{eyebrow}</span>}
              {title && <h1 class="title-xl">{title}</h1>}
              {text && <p class="lead">{text}</p>}

              {(primaryCta || secondaryCta) && (
                <div class="cluster">
                  {primaryCta && <a class="btn btn-primary" href={withBase(primaryCta.href)}>{primaryCta.label}</a>}
                  {secondaryCta && <a class="btn btn-secondary" href={withBase(secondaryCta.href)}>{secondaryCta.label}</a>}
                </div>
              )}
            </div>
          ) : null}

          {hasMobileCopy && (
            <div class="mobile-hero-copy">
              <div class="stack hero-copy-card">
                {mobileEyebrow && <span class="eyebrow">{mobileEyebrow}</span>}
                {mobileTitle && <h1 class="title-lg">{mobileTitle}</h1>}
                {mobileText && <p class="lead">{mobileText}</p>}

                {(mobilePrimaryCta || mobileSecondaryCta) && (
                  <div class="cluster hero-mobile-actions">
                    {mobilePrimaryCta && <a class="btn btn-primary" href={withBase(mobilePrimaryCta.href)}>{mobilePrimaryCta.label}</a>}
                    {mobileSecondaryCta && <a class="btn btn-secondary" href={withBase(mobileSecondaryCta.href)}>{mobileSecondaryCta.label}</a>}
                  </div>
                )}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>

    {hasFrame && (
      <div class="hero-frame hero-frame-static">
        <div class="container frame-inner">
          {serviceSummary && (
            <p>
              <strong>Service Times</strong>
              <span>{serviceSummary}</span>
            </p>
          )}
          {location && (
            <p>
              <strong>Location</strong>
              <span>{location}</span>
            </p>
          )}
        </div>
      </div>
    )}

    <div class="sr-only">
      {title}
      {text}
    </div>
  </section>
) : (
  <section
    class="full-hero surface-dark"
    aria-label="Homepage hero"
    style={`--hero-poster-url: url("${resolvedPoster}"); --hero-mobile-poster-url: url("${resolvedMobilePoster}")`}
  >
    <div class="hero-media">
      <video class="hero-video" autoplay muted loop playsinline poster={resolvedPoster} preload="metadata" aria-label={videoAlt}>
        <source src={resolvedVideoSrc} type="video/mp4" />
      </video>
      <div class="hero-scrim"></div>
    </div>

    <div class="hero-content">
      <div class="container hero-layout">
        {leftPillars.length > 0 ? (
          <div class="pillar-wrap desktop-pillar" aria-label="Faith pillars">
            <h1 class="pillar-heading">
              {leftPillars.map((pillar) => (
                <span class="pillar-line">{pillar}</span>
              ))}
            </h1>
          </div>
        ) : (eyebrow || title || text || primaryCta || secondaryCta) ? (
          <div class="stack hero-stack">
            {eyebrow && <span class="eyebrow">{eyebrow}</span>}
            {title && <h1 class="title-xl">{title}</h1>}
            {text && <p class="lead">{text}</p>}

            {(primaryCta || secondaryCta) && (
              <div class="cluster">
                {primaryCta && <a class="btn btn-primary" href={withBase(primaryCta.href)}>{primaryCta.label}</a>}
                {secondaryCta && <a class="btn btn-secondary" href={withBase(secondaryCta.href)}>{secondaryCta.label}</a>}
              </div>
            )}
          </div>
        ) : null}

        {hasMobileCopy && (
          <div class="mobile-hero-copy">
            <div class="stack hero-copy-card">
              {mobileEyebrow && <span class="eyebrow">{mobileEyebrow}</span>}
              {mobileTitle && <h1 class="title-lg">{mobileTitle}</h1>}
              {mobileText && <p class="lead">{mobileText}</p>}

              {(mobilePrimaryCta || mobileSecondaryCta) && (
                <div class="cluster hero-mobile-actions">
                  {mobilePrimaryCta && <a class="btn btn-primary" href={withBase(mobilePrimaryCta.href)}>{mobilePrimaryCta.label}</a>}
                  {mobileSecondaryCta && <a class="btn btn-secondary" href={withBase(mobileSecondaryCta.href)}>{mobileSecondaryCta.label}</a>}
                </div>
              )}
            </div>
          </div>
        )}
      </div>
      {hasFrame && (
        <div class="hero-frame">
          <div class="container frame-inner">
            {serviceSummary && (
              <p>
                <strong>Service Times</strong>
                <span>{serviceSummary}</span>
              </p>
            )}
            {location && (
              <p>
                <strong>Location</strong>
                <span>{location}</span>
              </p>
            )}
          </div>
        </div>
      )}
    </div>
    
    <div class="sr-only">
      {title}
      {text}
    </div>

    <p class="video-fallback-note" aria-live="polite">
      Showing a static hero for smoother playback on this device.
    </p>
  </section>
)}

<style>
  .full-hero {
    position: relative;
    min-height: clamp(480px, 72vh, 860px);
  }

  .static-hero {
    min-height: initial;
  }

  .hero-main {
    position: relative;
    min-height: clamp(460px, 66vh, 760px);
  }

  .hero-media,
  .hero-video,
  .hero-scrim,
  .hero-content {
    position: absolute;
    inset: 0;
  }

  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #0f1219;
    transition: opacity 260ms ease;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-media {
    background-image: var(--hero-poster-url);
    background-position: center;
    background-size: cover;
    background-color: #0f1219;
  }

  .full-hero.fallback-static .hero-video {
    opacity: 0;
    pointer-events: none;
  }

  .hero-scrim {
    background:
      linear-gradient(180deg, rgba(8, 9, 12, 0.2) 0%, rgba(8, 9, 12, 0.6) 72%, rgba(8, 9, 12, 0.85) 100%),
      radial-gradient(circle at 78% 18%, rgba(255, 255, 255, 0.1), transparent 40%);
  }

  .static-hero .hero-scrim {
    background:
      linear-gradient(180deg, rgba(8, 9, 12, 0.04) 0%, rgba(8, 9, 12, 0.18) 76%, rgba(8, 9, 12, 0.3) 100%),
      radial-gradient(circle at 78% 18%, rgba(255, 255, 255, 0.07), transparent 42%);
  }

  .hero-content {
    display: grid;
    align-items: stretch;
    z-index: 1;
  }

  .hero-layout {
    display: grid;
    align-items: center;
    min-height: 100%;
    padding-bottom: clamp(6.2rem, 10vw, 9rem);
  }

  .hero-stack {
    padding-bottom: clamp(2rem, 6vw, 4rem);
    max-width: 52ch;
  }

  .pillar-wrap {
    max-width: 28ch;
  }

  .mobile-hero-copy {
    display: none;
    align-self: end;
    max-width: 24rem;
  }

  .hero-copy-card {
    padding: 1.15rem;
    border-radius: 1rem;
    background:
      linear-gradient(180deg, rgba(9, 12, 18, 0.88), rgba(9, 12, 18, 0.72));
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.24);
    backdrop-filter: blur(10px);
  }

  .hero-copy-card .lead,
  .hero-copy-card .title-lg {
    color: #f4f7fc;
  }

  .hero-mobile-actions {
    gap: 0.7rem;
  }

  .pillar-heading {
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }

  .pillar-line {
    display: block;
    font-family: 'Barlow Condensed', 'Barlow', sans-serif;
    font-size: clamp(2rem, 4.4vw, 3.8rem);
    font-style: italic;
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: 0.02em;
    color: #f4f7fc;
    text-shadow: 0 5px 22px rgba(0, 0, 0, 0.34);
  }

  .hero-frame {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(10, 12, 17, 0.58);
    backdrop-filter: blur(7px);
    padding: 0.95rem 0;
  }

  .hero-frame-static {
    position: relative;
    left: auto;
    right: auto;
    bottom: auto;
  }

  .frame-inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .frame-inner p {
    margin: 0;
    display: grid;
    gap: 0.18rem;
    color: #e6edf8;
    font-size: 0.94rem;
  }

  .frame-inner strong {
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #5d8ff2;
  }

  .full-hero .lead {
    color: #e4eaf5;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .video-fallback-note {
    position: absolute;
    right: 0.8rem;
    top: 0.8rem;
    z-index: 2;
    margin: 0;
    display: none;
    padding: 0.45rem 0.65rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #dce6f8;
    background: rgba(7, 10, 18, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(5px);
  }

  .full-hero.fallback-static .video-fallback-note {
    display: inline-flex;
    align-items: center;
  }

  @media (max-width: 740px) {
    .full-hero {
      min-height: 460px;
    }

    .hero-main {
      min-height: 430px;
    }

    .hero-layout {
      padding-top: 3.2rem;
      padding-bottom: 7.2rem;
      align-items: end;
    }

    .desktop-pillar,
    .hero-stack {
      display: none;
    }

    .mobile-hero-copy {
      display: grid;
      max-width: 19rem;
    }

    .hero-copy-card {
      padding: 1rem;
      gap: 0.8rem;
      background:
        linear-gradient(180deg, rgba(8, 11, 18, 0.94), rgba(8, 11, 18, 0.76));
    }

    .hero-copy-card .eyebrow {
      font-size: 0.76rem;
    }

    .hero-copy-card .title-lg {
      font-size: clamp(1.9rem, 8vw, 2.5rem);
      line-height: 0.95;
    }

    .hero-copy-card .lead {
      font-size: 0.98rem;
      line-height: 1.5;
    }

    .hero-video {
      display: none;
    }

    .hero-media {
      background-image: var(--hero-mobile-poster-url);
      background-position: center right 38%;
    }

    .hero-scrim {
      background:
        linear-gradient(180deg, rgba(7, 8, 12, 0.28) 0%, rgba(7, 8, 12, 0.38) 26%, rgba(7, 8, 12, 0.8) 72%, rgba(7, 8, 12, 0.94) 100%),
        linear-gradient(90deg, rgba(8, 10, 16, 0.84) 0%, rgba(8, 10, 16, 0.52) 48%, rgba(8, 10, 16, 0.28) 100%);
    }

    .hero-frame {
      padding: 0.8rem 0;
      background: rgba(10, 12, 17, 0.72);
    }

    .frame-inner {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }

    .frame-inner p {
      font-size: 0.88rem;
    }

    .video-fallback-note {
      right: 0.55rem;
      top: 0.55rem;
      font-size: 0.64rem;
      padding: 0.38rem 0.5rem;
    }
  }

  @media (max-width: 420px) {
    .full-hero {
      min-height: 430px;
    }

    .hero-main {
      min-height: 405px;
    }

    .hero-layout {
      padding-top: 2.85rem;
      padding-bottom: 6.7rem;
    }

    .mobile-hero-copy {
      max-width: 17rem;
    }

    .frame-inner strong {
      font-size: 0.68rem;
    }
  }
</style>

<script is:inline>
  const initVideoFallback = () => {
    const heroes = document.querySelectorAll('.full-hero');
    if (heroes.length === 0) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
    const saveData = Boolean(connection && connection.saveData);

    heroes.forEach((hero) => {
      const video = hero.querySelector('.hero-video');
      if (!(video instanceof HTMLVideoElement)) return;

      let hasFallback = false;

      const setFallback = () => {
        if (hasFallback) return;
        hasFallback = true;
        hero.classList.add('fallback-static');
        video.pause();
      };

      if (prefersReducedMotion || saveData) {
        setFallback();
        return;
      }

      video.addEventListener('error', () => setFallback(), { once: true });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVideoFallback, { once: true });
  } else {
    initVideoFallback();
  }
</script>

---
import { withBase } from '../utils/paths';
import OutlineGraphic from './OutlineGraphic.astro';

interface Props {
  eyebrow?: string;
  title: string;
  text: string;
  primary: { label: string; href: string };
  secondary?: { label: string; href: string };
  dark?: boolean;
  embedded?: boolean;
}

const { eyebrow, title, text, primary, secondary, dark = true, embedded = false } = Astro.props;
---

{embedded ? (
  <div class={`cta-band ${dark ? 'dark' : 'light'}`}>
    <div class="stack">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h2 class="title-lg">{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="cluster">
      <a class="btn btn-primary" href={withBase(primary.href)}>{primary.label}</a>
      {secondary && <a class="btn btn-secondary" href={withBase(secondary.href)}>{secondary.label}</a>}
    </div>
  </div>
) : (
  <section class={`section-tight cta-stage ${dark ? 'dark' : 'light'}`}>
    <div class="container">
      <div class={`cta-band ${dark ? 'dark' : 'light'}`}>
        <OutlineGraphic variant="dove" className="cta-outline" />
        <div class="stack">
          {eyebrow && <span class="eyebrow">{eyebrow}</span>}
          <h2 class="title-lg">{title}</h2>
          <p class="lead">{text}</p>
        </div>
        <div class="cluster">
          <a class="btn btn-primary" href={withBase(primary.href)}>{primary.label}</a>
          {secondary && <a class="editorial-link cta-link" href={withBase(secondary.href)}>{secondary.label}</a>}
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .cta-stage.dark {
    background:
      linear-gradient(180deg, rgba(11, 16, 24, 0.98) 0%, rgba(7, 10, 15, 1) 100%);
  }

  .cta-stage.light {
    background: transparent;
  }

  .cta-band {
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 1.1fr) auto;
    align-items: center;
    padding: clamp(2rem, 5vw, 3.2rem) 0;
    overflow: hidden;
    position: relative;
  }

  .cta-outline {
    right: -4rem;
    top: auto;
    bottom: -4rem;
    width: 20rem;
    height: 20rem;
    opacity: 0.08;
    --outline-rotate: 8deg;
  }

  .cta-band::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at top right, rgba(45, 120, 255, 0.24), transparent 24%);
    pointer-events: none;
  }

  .cta-band > * {
    position: relative;
    z-index: 1;
  }

  .cta-band.dark {
    background: linear-gradient(180deg, #101722 0%, #080d13 100%);
    color: var(--text);
  }

  .cta-band.dark h2,
  .cta-band.dark p {
    color: var(--text);
  }

  .cta-band.light {
    background: transparent;
  }

  .cta-band .cluster .btn {
    width: auto;
  }

  .cta-link {
    color: var(--text);
  }

  @media (max-width: 880px) {
    .cta-band {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .cta-outline {
      width: 11rem;
      height: 11rem;
      right: -2rem;
      bottom: -2rem;
    }
  }
</style>

---
import { navLinks } from '../data/site';
import { withBase, withoutBase } from '../utils/paths';
import OutlineGraphic from './OutlineGraphic.astro';

interface Props {
  pathname: string;
  enableBladePreview?: boolean;
}

const { pathname, enableBladePreview = false } = Astro.props;

const normalizePath = (value: string) => {
  if (value.length > 1 && value.endsWith('/')) return value.slice(0, -1);
  return value;
};

const currentPath = normalizePath(withoutBase(pathname));

const isActive = (href: string) => {
  const target = normalizePath(href);
  if (target === '/') return currentPath === '/';
  return currentPath === target || currentPath.startsWith(`${target}/`);
};

const brandLogo = withBase('/images/logo-white.png');
const visibleLinks = [
  { label: 'Visit', href: '/plan-your-visit' },
  { label: 'Messages', href: '/messages' },
  { label: 'Next Steps', href: '/next-steps' },
  { label: 'Give', href: '/give' }
];
const aboutChildren = navLinks.find((link) => link.label === 'About')?.children ?? [];
---

<header class={`site-header ${enableBladePreview ? 'site-header-home' : ''}`}>
  <div class="container header-inner">
    <a href={withBase('/')} class="brand" style={`--brand-logo-url: url("${brandLogo}")`}>
      <span class="brand-logo" aria-hidden="true"></span>
      <span class="brand-wordmark">
        <span>Limitless</span>
        <small>Church</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      {visibleLinks.map((link) => (
        <a href={withBase(link.href)} class={isActive(link.href) ? 'active' : ''}>{link.label}</a>
      ))}
    </nav>

    <button
      type="button"
      class="menu-trigger"
      data-menu-open
      aria-haspopup="dialog"
      aria-controls="site-menu-dialog"
      aria-expanded="false"
    >
      Menu
    </button>
  </div>
</header>

<dialog class="site-menu-dialog" id="site-menu-dialog" aria-label="Site menu">
  <div class="site-menu-shell">
    <OutlineGraphic src="/brand/mission/outline-04.png" className="site-menu-outline site-menu-outline-main" />
    <div class="site-menu-top">
      <a href={withBase('/')} class="menu-brand" style={`--brand-logo-url: url("${brandLogo}")`}>
        <span class="brand-logo" aria-hidden="true"></span>
        <span class="brand-wordmark">
          <span>Limitless</span>
          <small>Church</small>
        </span>
      </a>
      <button type="button" class="menu-close" data-menu-close aria-label="Close menu">
        <span>Close</span>
        <span class="menu-close-icon" aria-hidden="true"></span>
      </button>
    </div>

    <div class="site-menu-grid">
      <div class="site-menu-primary">
        {visibleLinks.map((link) => (
          <a href={withBase(link.href)} class={isActive(link.href) ? 'active' : ''}>{link.label}</a>
        ))}
      </div>

      <div class="site-menu-secondary">
        <section class="menu-column">
          <p>Start Here</p>
          <a href={withBase('/plan-your-visit')} class={isActive('/plan-your-visit') ? 'active' : ''}>Plan Your Visit</a>
          <a href={withBase('/next-steps')} class={isActive('/next-steps') ? 'active' : ''}>Next Steps</a>
          <a href={withBase('/kids')} class={isActive('/kids') ? 'active' : ''}>Limitless Kids</a>
          <a href={withBase('/care')} class={isActive('/care') ? 'active' : ''}>Care + Prayer</a>
        </section>

        <section class="menu-column">
          <p>Explore</p>
          {navLinks.map((link) => (
            <a href={withBase(link.href)} class={isActive(link.href) ? 'active' : ''}>{link.label}</a>
          ))}
        </section>

        <section class="menu-column">
          <p>About</p>
          {aboutChildren.map((child) => (
            <a href={withBase(child.href)} class={isActive(child.href) ? 'active' : ''}>{child.label}</a>
          ))}
        </section>
      </div>
    </div>
  </div>
</dialog>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    background: linear-gradient(180deg, rgba(4, 7, 11, 0.96) 0%, rgba(4, 7, 11, 0.8) 100%);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .site-header-home {
    background: linear-gradient(180deg, rgba(4, 7, 11, 0.82) 0%, rgba(4, 7, 11, 0.5) 100%);
  }

  .header-inner {
    min-height: 5rem;
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: #f4f7fc;
  }

  .brand-logo {
    width: 2.65rem;
    height: 2.65rem;
    border-radius: 0.5rem;
    background-image: var(--brand-logo-url);
    background-position: center;
    background-repeat: no-repeat;
    background-size: contain;
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.22));
  }

  .brand-wordmark {
    display: grid;
    gap: 0.05rem;
    line-height: 1;
  }

  .brand-wordmark span,
  .brand-wordmark small {
    font-family: 'Barlow Condensed', sans-serif;
    text-transform: uppercase;
  }

  .brand-wordmark span {
    font-size: 1.34rem;
    letter-spacing: 0.04em;
  }

  .brand-wordmark small {
    font-size: 0.64rem;
    color: #a9b6ca;
    letter-spacing: 0.2em;
  }

  .desktop-nav {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .desktop-nav a {
    color: #d0d7e2;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.96rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .desktop-nav a:hover,
  .desktop-nav a:focus-visible,
  .desktop-nav a.active {
    color: #ffffff;
  }

  .menu-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.7rem;
    padding: 0;
    border-radius: 0;
    border: 0;
    background: transparent;
    color: #f0f4fa;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.96rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .menu-trigger::before {
    content: '';
    width: 1.1rem;
    height: 0.62rem;
    border-top: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
  }

  .menu-trigger:hover,
  .menu-trigger:focus-visible,
  .menu-trigger[aria-expanded='true'] {
    color: #ffffff;
  }

  .site-menu-dialog {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }

  .site-menu-dialog::backdrop {
    background: rgba(5, 8, 12, 0.7);
    backdrop-filter: blur(3px);
  }

  .site-menu-shell {
    position: relative;
    min-height: 100dvh;
    padding: max(1.2rem, env(safe-area-inset-top)) 1.4rem 1.6rem;
    background:
      radial-gradient(circle at 74% 62%, rgba(45, 120, 255, 0.11), transparent 20%),
      linear-gradient(180deg, rgba(12, 10, 12, 0.99) 0%, rgba(6, 7, 10, 1) 100%);
  }

  .site-menu-outline {
    position: absolute;
    pointer-events: none;
  }

  .site-menu-outline-main {
    right: clamp(0rem, 5vw, 3rem);
    bottom: -3rem;
    width: clamp(16rem, 32vw, 28rem);
    height: clamp(16rem, 32vw, 28rem);
    opacity: 0.11;
    --outline-rotate: -6deg;
  }

  .site-menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .menu-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: #f4f7fc;
  }

  .menu-close {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: #edf2f8;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.96rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .menu-close-icon {
    position: relative;
    width: 1.25rem;
    height: 1.25rem;
    display: inline-block;
  }

  .menu-close-icon::before,
  .menu-close-icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1.2rem;
    height: 1px;
    background: currentColor;
    transform-origin: center;
  }

  .menu-close-icon::before {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .menu-close-icon::after {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  .site-menu-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
    gap: clamp(2rem, 8vw, 8rem);
    align-items: start;
    padding: clamp(4rem, 10vw, 8.5rem) 0 2rem;
  }

  .site-menu-primary,
  .site-menu-secondary {
    display: grid;
  }

  .site-menu-primary {
    gap: 0.22rem;
  }

  .site-menu-primary a {
    color: #ffffff;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: clamp(3.5rem, 7vw, 6.8rem);
    font-weight: 700;
    line-height: 0.88;
    letter-spacing: -0.02em;
    text-transform: none;
  }

  .site-menu-secondary {
    gap: 2.3rem 2.9rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding-top: 0.6rem;
  }

  .menu-column {
    display: grid;
    gap: 0.45rem;
  }

  .menu-column p {
    margin: 0 0 0.35rem;
    color: #8eb3ff;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .menu-column a {
    color: #edf2f8;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: clamp(1.35rem, 2.2vw, 2.2rem);
    font-weight: 700;
    line-height: 1.02;
  }

  .site-menu-primary a.active,
  .menu-column a.active,
  .site-menu-primary a:hover,
  .menu-column a:hover {
    color: #ffffff;
  }

  @media (max-width: 1080px) {
    .desktop-nav {
      display: none;
    }
  }

  @media (max-width: 700px) {
    .header-inner {
      min-height: 4.5rem;
    }

    .brand-logo {
      width: 2.3rem;
      height: 2.3rem;
    }

    .brand-wordmark span {
      font-size: 1.18rem;
    }

    .site-menu-shell {
      padding-inline: 1rem;
    }

    .site-menu-outline-main {
      right: -1rem;
      width: 14rem;
      height: 14rem;
      bottom: 1rem;
    }

    .site-menu-grid,
    .site-menu-secondary {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  const initSiteMenu = () => {
    const dialog = document.getElementById('site-menu-dialog');
    const openButton = document.querySelector('[data-menu-open]');
    if (!(dialog instanceof HTMLDialogElement) || !(openButton instanceof HTMLButtonElement)) return;

    const closeButtons = dialog.querySelectorAll('[data-menu-close]');
    const menuLinks = dialog.querySelectorAll('a');

    const setPageScroll = (locked) => {
      document.documentElement.style.overflow = locked ? 'hidden' : '';
      document.body.style.overflow = locked ? 'hidden' : '';
    };

    const closeMenu = () => {
      openButton.setAttribute('aria-expanded', 'false');
       setPageScroll(false);
      if (dialog.open) dialog.close();
    };

    openButton.addEventListener('click', () => {
      openButton.setAttribute('aria-expanded', 'true');
      setPageScroll(true);
      if (!dialog.open) dialog.showModal();
    });

    closeButtons.forEach((button) => {
      button.addEventListener('click', closeMenu);
    });

    menuLinks.forEach((link) => {
      link.addEventListener('click', () => closeMenu());
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) closeMenu();
    });

    dialog.addEventListener('cancel', () => {
      setPageScroll(false);
    });

    dialog.addEventListener('close', () => {
      openButton.setAttribute('aria-expanded', 'false');
      setPageScroll(false);
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSiteMenu, { once: true });
  } else {
    initSiteMenu();
  }
</script>

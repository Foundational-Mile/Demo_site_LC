<script is:inline>
  const initBladePreview = () => {
    const triggerButtons = Array.from(document.querySelectorAll('[data-blade-open]'));
    if (triggerButtons.length === 0) return;

    const closeDialog = (dialog) => {
      if (!(dialog instanceof HTMLDialogElement)) return;
      if (!dialog.open) return;
      dialog.classList.remove('is-mounted');
      window.setTimeout(() => {
        if (dialog.open) dialog.close();
      }, 220);
      triggerButtons.forEach((button) => {
        const expanded = button.getAttribute('data-blade-open') === dialog.id ? 'false' : button.getAttribute('aria-expanded') ?? 'false';
        button.setAttribute('aria-expanded', expanded);
      });
    };

    const openDialog = (dialogId) => {
      const dialog = document.getElementById(dialogId);
      if (!(dialog instanceof HTMLDialogElement)) return;

      document.querySelectorAll('.blade-dialog[open]').forEach((openDialogEl) => {
        if (openDialogEl instanceof HTMLDialogElement && openDialogEl.id !== dialogId) {
          openDialogEl.classList.remove('is-mounted');
          openDialogEl.close();
        }
      });

      if (!dialog.open) dialog.showModal();
      requestAnimationFrame(() => {
        dialog.classList.add('is-mounted');
      });

      triggerButtons.forEach((button) => {
        const active = button.getAttribute('data-blade-open') === dialogId;
        button.setAttribute('aria-expanded', active ? 'true' : 'false');
      });

      document.documentElement.classList.add('blade-preview-open');
    };

    triggerButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const dialogId = button.getAttribute('data-blade-open');
        if (dialogId) openDialog(dialogId);
      });
    });

    document.querySelectorAll('.blade-dialog').forEach((dialog) => {
      if (!(dialog instanceof HTMLDialogElement)) return;

      dialog.querySelectorAll('[data-blade-close]').forEach((button) => {
        button.addEventListener('click', () => closeDialog(dialog));
      });

      dialog.addEventListener('click', (event) => {
        const rect = dialog.getBoundingClientRect();
        const within =
          event.clientX >= rect.left &&
          event.clientX <= rect.right &&
          event.clientY >= rect.top &&
          event.clientY <= rect.bottom;

        if (!within) closeDialog(dialog);
      });

      dialog.addEventListener('close', () => {
        dialog.classList.remove('is-mounted');
        triggerButtons.forEach((button) => {
          if (button.getAttribute('data-blade-open') === dialog.id) {
            button.setAttribute('aria-expanded', 'false');
          }
        });

        if (!document.querySelector('.blade-dialog[open]')) {
          document.documentElement.classList.remove('blade-preview-open');
        }
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBladePreview, { once: true });
  } else {
    initBladePreview();
  }
</script>

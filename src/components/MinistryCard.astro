---
import { withBase } from '../utils/paths';

interface Props {
  title: string;
  audience: string;
  description: string;
  image: string;
}

const { title, audience, description, image } = Astro.props;
---

<article class="card ministry-card">
  <img src={image} alt={`${title} ministry`} loading="lazy" />
  <div class="ministry-overlay"></div>
  <div class="stack-sm content">
    <p class="audience">{audience}</p>
    <h3>{title}</h3>
    <p>{description}</p>
    <div class="ministry-footer">
      <span class="ministry-kicker">Find Your Place</span>
      <a href={withBase('/next-steps')} class="editorial-link">Learn More</a>
    </div>
  </div>
</article>

<style>
  .ministry-card {
    overflow: hidden;
    min-height: 25.5rem;
    background: #09111a;
  }

  .ministry-card > img,
  .ministry-overlay,
  .ministry-card .content {
    position: absolute;
    inset: 0;
  }

  .ministry-card > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ministry-overlay {
    background:
      linear-gradient(180deg, rgba(7, 10, 16, 0.06) 0%, rgba(7, 10, 16, 0.36) 38%, rgba(7, 10, 16, 0.88) 100%);
  }

  .ministry-card .content {
    display: grid;
    align-content: end;
    gap: 0.75rem;
    padding: 1.2rem;
    z-index: 1;
  }

  .ministry-card h3 {
    font-size: 1.75rem;
    color: #f4f7fc;
  }

  .audience {
    color: #8eb3ff;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ministry-card p {
    color: #d8e0ec;
  }

  .ministry-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.2rem;
  }

  .ministry-kicker {
    color: rgba(255, 255, 255, 0.72);
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ministry-card .editorial-link {
    color: #ffffff;
  }

  @media (max-width: 700px) {
    .ministry-card {
      min-height: 21rem;
    }

    .ministry-card h3 {
      font-size: 1.5rem;
    }
  }
</style>

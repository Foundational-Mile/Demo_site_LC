---
import { churchMeta } from '../data/site';
import { withBase } from '../utils/paths';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<section class={`visit-plan card ${compact ? 'compact' : ''}`}>
  <div class="stack visit-plan-copy">
    <span class="eyebrow">First Time at Limitless</span>
    <h2 class="title-md">Planning a visit should feel clear before you even pull into the parking lot.</h2>
    <p>
      Let us know you are coming and our team can help with service times, kids check-in, and what to expect when you arrive.
    </p>
  </div>

  <div class="visit-plan-details">
    <div class="stack-sm">
      <h3>Service Times</h3>
      <ul>
        {churchMeta.serviceTimes.map((time) => (
          <li>{time}</li>
        ))}
      </ul>
    </div>

    <div class="stack-sm visit-plan-actions">
      <p>{churchMeta.address}</p>
      <div class="cluster">
        <a class="btn btn-primary" href={withBase('/plan-your-visit')}>Plan Your Visit</a>
        <a class="editorial-link" href={withBase('/kids')}>What About Kids?</a>
      </div>
    </div>
  </div>
</section>

<style>
  .visit-plan {
    padding: clamp(1.5rem, 3.2vw, 2.2rem);
    display: grid;
    gap: 1.3rem;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    background:
      radial-gradient(circle at top right, rgba(45, 120, 255, 0.12), transparent 28%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(244, 241, 235, 0.96) 100%);
    box-shadow: 0 30px 60px rgba(6, 10, 16, 0.08);
  }

  .visit-plan p,
  .visit-plan li {
    color: #556277;
  }

  .visit-plan h3 {
    font-size: 1.12rem;
  }

  .visit-plan-copy h2 {
    max-width: 12ch;
  }

  .visit-plan-details {
    display: grid;
    gap: 1rem;
    align-content: space-between;
  }

  .visit-plan ul {
    display: grid;
    gap: 0.42rem;
  }

  .compact {
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.6fr) auto;
    align-items: end;
  }

  .compact .visit-plan-copy h2 {
    font-size: clamp(1.9rem, 3vw, 3rem);
  }

  .compact .visit-plan-details {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: end;
  }

  @media (max-width: 900px) {
    .visit-plan {
      grid-template-columns: 1fr;
    }
  }

  .visit-plan-actions .cluster {
    align-items: flex-start;
  }

  .visit-plan-actions .btn {
    width: auto;
  }

  @media (max-width: 700px) {
    .visit-plan {
      padding: 1.05rem;
    }

    .compact .visit-plan-details {
      grid-template-columns: 1fr;
    }

    .visit-plan-actions .btn {
      width: 100%;
    }
  }
</style>

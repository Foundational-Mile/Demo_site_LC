---
import { churchMeta, footerLinks } from '../data/site';
import { withBase } from '../utils/paths';

const footerGroups = [
  {
    title: 'Visit',
    links: footerLinks.explore
  },
  {
    title: 'Connect',
    links: footerLinks.connect
  },
  {
    title: 'Watch + Give',
    links: footerLinks.resources
  }
];
---

<footer class="site-footer surface-ink">
  <div class="container footer-shell">
    <div class="footer-intro stack-lg">
      <div class="stack-sm">
        <span class="eyebrow">Limitless Church</span>
        <h2 class="title-md">{churchMeta.tagline}</h2>
        <p class="footer-copy">
          Join us in Nixa for worship, practical teaching, and a church family ready to help you take your next step.
        </p>
      </div>

      <div class="footer-meta">
        <p><strong>Location</strong><span>{churchMeta.address}</span></p>
        <p><strong>Contact</strong><span>{churchMeta.phone}</span></p>
      </div>

      <div class="cluster footer-actions">
        <a href={withBase('/plan-your-visit')} class="btn btn-primary">First-Time Guide</a>
        <a href={withBase('/messages')} class="btn btn-secondary">Watch Messages</a>
      </div>
    </div>

    <div class="footer-links-grid">
      {footerGroups.map((group) => (
        <div class="footer-link-group">
          <h3>{group.title}</h3>
          <ul>
            {group.links.map((link) => (
              <li><a href={withBase(link.href)}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {new Date().getFullYear()} Limitless Church. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(2.8rem, 5vw, 4.8rem);
    padding: 3.2rem 0 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-shell {
    display: grid;
    gap: 1.4rem;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-intro .eyebrow {
    color: #f4f7fc;
  }

  .footer-intro .eyebrow::after {
    background: #7da9ff;
  }

  .footer-copy {
    color: #c0cad8;
    max-width: 42ch;
  }

  .footer-meta {
    display: grid;
    gap: 0.8rem;
  }

  .footer-meta p {
    display: grid;
    gap: 0.22rem;
    color: #d9e2ee;
  }

  .footer-meta strong {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #7da9ff;
  }

  .footer-meta span {
    color: #c0cad8;
    font-size: 0.95rem;
  }

  .footer-links-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .footer-link-group {
    display: grid;
    align-content: start;
    gap: 0.7rem;
  }

  .footer-link-group h3 {
    color: #f4f7fc;
    font-size: 1.05rem;
    letter-spacing: 0.06em;
  }

  .footer-link-group ul {
    display: grid;
    gap: 0.5rem;
  }

  .footer-link-group a {
    color: #c0cad8;
    font-size: 0.95rem;
  }

  .footer-link-group a:hover,
  .footer-link-group a:focus-visible {
    color: #ffffff;
  }

  .footer-actions .btn {
    width: auto;
  }

  .footer-bottom {
    padding-top: 1rem;
  }

  .footer-bottom p {
    color: #9ca9bd;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 980px) {
    .footer-shell,
    .footer-links-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

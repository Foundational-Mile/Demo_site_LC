---
import { withBase } from '../utils/paths';

interface Props {
  title: string;
  speaker: string;
  date: string;
  series: string;
  duration: string;
  summary: string;
  image: string;
  featured?: boolean;
}

const { title, speaker, date, series, duration, summary, image, featured = false } = Astro.props;
---

<article class={`card message-card ${featured ? 'featured' : ''}`}>
  <div class="message-media">
    <img src={image} alt={`${title} message thumbnail`} loading="lazy" />
    <div class="message-overlay"></div>
  </div>
  <div class="stack-sm content">
    <p class="message-label">{series}</p>
    <h3>{title}</h3>
    <p class="meta">{speaker}</p>
    <p>{summary}</p>
    <div class="message-footer">
      <p class="meta">{date} / {duration}</p>
      <a class="editorial-link" href={withBase('/messages')}>Watch Message</a>
    </div>
  </div>
</article>

<style>
  .message-card {
    overflow: hidden;
    min-height: 26rem;
    background: linear-gradient(180deg, #0a1119 0%, #060a10 100%);
  }

  .message-media {
    position: relative;
    min-height: 60%;
  }

  .message-media img {
    width: 100%;
    height: 100%;
    min-height: 15rem;
    object-fit: cover;
  }

  .message-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(7, 11, 16, 0.02) 0%, rgba(7, 11, 16, 0.58) 100%);
  }

  .message-card .content {
    padding: 1.2rem 1.15rem 1.25rem;
    align-content: space-between;
    min-height: 40%;
  }

  .message-card h3 {
    font-size: 1.85rem;
    line-height: 0.92;
    color: inherit;
  }

  .message-label {
    color: #91b6ff;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .message-card .meta {
    color: #95a4bb;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .message-card p {
    color: #c0cad8;
  }

  .message-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.35rem;
  }

  .message-card.featured {
    transform: none;
    border-color: rgba(125, 169, 255, 0.18);
    box-shadow: 0 34px 64px rgba(0, 0, 0, 0.16);
  }

  @media (max-width: 700px) {
    .message-card {
      min-height: 23rem;
    }

    .message-card .content {
      padding: 0.95rem;
    }

    .message-card h3 {
      font-size: 1.6rem;
    }

    .message-footer {
      align-items: flex-start;
    }
  }
</style>

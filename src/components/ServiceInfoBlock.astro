---
import { churchMeta } from '../data/site';
import { withBase } from '../utils/paths';
---

<section class="service-info card">
  <div class="stack-sm">
    <p class="service-label">Join us this Sunday</p>
    <h2 class="title-md">Service Times + Location</h2>
  </div>
  <ul>
    {churchMeta.serviceTimes.map((time) => (
      <li>{time}</li>
    ))}
  </ul>
  <p>{churchMeta.address}</p>
  <a class="editorial-link" href={withBase('/plan-your-visit')}>Get Directions + Plan Visit</a>
</section>

<style>
  .service-info {
    padding: 1.35rem;
    display: grid;
    gap: 1rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(244, 241, 235, 0.96) 100%);
  }

  .service-label {
    color: var(--accent-strong);
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .service-info ul {
    display: grid;
    gap: 0.45rem;
    color: #344358;
    font-weight: 700;
  }

  .service-info p:last-of-type {
    color: #5a6880;
  }
</style>
